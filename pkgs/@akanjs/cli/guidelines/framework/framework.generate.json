  "group": "core",
  "docsSource": "apps/akan/page/(docs)/docs/intro/fundamentals.tsx",
  "codegenPriority": 1,
  "deprecated": false,
  "scans": [
    {
      "type": "docs",
      "description": "Current docs source for Akan.js Framework",
      "path": "apps/akan/page/(docs)/docs/intro/fundamentals.tsx"
    },
    {
      "type": "example",
      "description": "Existing Akan implementation examples",
      "path": "{apps,libs}/*/lib/**/*.ts",
      "sample": 4
    }
  ],
  "update": {
    "filePath": "./framework.instruction.md",
    "contents": ["file ownership", "current API patterns", "codegen rules", "theming and UI customization"],
    "rules": [
      "Use current Akan APIs only",
      "Keep output parseable for codegen",
      "Include ownership boundaries",
      "Carry no meta about this document itself — it renders into every workspace's always-loaded AGENTS.md"
    ]
  },
  "page": "apps/akan/page/(docs)/docs/intro/fundamentals.tsx"
}
