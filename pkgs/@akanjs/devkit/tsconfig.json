{
  "extends": "../../../tsconfig.json",
  "files": [],
  // `pkgs/akanjs` is reached through the workspace path aliases, but an ambient declaration nothing
  // imports is not pulled in that way — so the framework's own `react-server-dom-webpack` shims have to
  // be named here, or every compile of this package reports the vendor module as implicitly `any`.
  "include": ["**/*.ts", "**/*.tsx", "../../akanjs/server/types/*.d.ts"],
  // Lint fixtures are inputs to `lint/gritRules.test.ts`, not code: they reference undeclared
  // identifiers on purpose so the rule under test has something to match.
  "exclude": ["lint/__fixtures__"]
}
